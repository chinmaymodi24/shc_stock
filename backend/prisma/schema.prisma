generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon "-pooler" host) used by the running app.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for `prisma migrate deploy`.
  // Set it to the same Neon URL without "-pooler" in the host.
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int    @id @default(autoincrement())
  /// USR-0001 — the employee code shown in the Employee list. The default is
  /// only there so the column could be added to an existing table; every
  /// insert goes through POST /api/users, which always assigns a real code.
  code         String @unique @default("")
  name         String
  email        String @unique
  passwordHash String
  /// Display name of the assigned role ("Super Admin", "Store Staff", or a
  /// custom role's name). Kept as text so the Employee list still reads
  /// sensibly for a row whose role was since deleted.
  role         String @default("Admin")
  /// The role this employee was created from. Null for a role that was
  /// deleted, or for legacy rows no preset maps onto.
  roleId       Int?
  roleRef      Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  phone       String    @default("")
  department  String    @default("")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// Per-module access, as {"Products": {"read", "write", "summary"}, …} plus
  /// "Settings: <tab>" entries — see src/permissions.js. Set by the Add
  /// Employee wizard's Permissions step and enforced by the API guard, the
  /// sidebar and every route guard. A Super Admin role ignores this map.
  permissions Json @default("{}")

  // Settings page — per-user preferences.
  notifyLowStock Boolean @default(true)
  notifyDelivery Boolean @default(true)
  notifyPayment  Boolean @default(false)
  notifyWeekly   Boolean @default(true)
  twoFactor      Boolean @default(false)
  rowsPerPage    Int     @default(10)
  dateFormat     String  @default("MMM D, YYYY (Jul 18, 2026)")
  /// When on, the Add Purchase / Add Sale forms prefill "Invoice No." with the
  /// next number in the PO-2024-##### / SO-2024-##### series.
  autoNumberDocs Boolean @default(true)

  notes DashboardNote[]

  modifiedBy String    @default("Admin")
  modifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("users")
}

/// A reusable set of permissions an employee can be created from.
///
/// The ready-made roles (isSystem) are rebuilt from src/permissions.js on every
/// server start, so a new module reaches them without a migration; custom
/// roles are created from the Add Employee wizard. Assigning a role copies its
/// permissions onto the employee, who can then be fine-tuned individually.
model Role {
  id           Int     @id @default(autoincrement())
  /// Stable id of a ready-made role (super_admin, admin, …). Null for custom.
  key          String? @unique
  name         String  @unique
  description  String  @default("")
  /// Icon name the app maps to an icon (stars, admin, manager, sales, store, custom).
  icon         String  @default("custom")
  permissions  Json    @default("{}")
  isSystem     Boolean @default(false)
  /// Holds every permission regardless of the map — only "Super Admin".
  isSuperAdmin Boolean @default(false)

  users User[]

  modifiedBy String   @default("Admin")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("roles")
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  description   String        @default("")
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
  products      Product[]

  @@map("categories")
}

model SubCategory {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("sub_categories")
}

model Product {
  id                 Int          @id @default(autoincrement())
  name               String
  sku                String       @unique
  categoryId         Int
  category           Category     @relation(fields: [categoryId], references: [id])
  subCategoryId      Int?
  subCategory        SubCategory? @relation(fields: [subCategoryId], references: [id])
  unit               String
  /// Relative path from the `/uploads` static route (e.g. "/uploads/xxx.png"),
  /// as returned by POST /api/upload. Null when the product has no photo —
  /// the list/detail views fall back to a placeholder icon.
  imageUrl           String?
  sellingPrice       Float
  costPrice          Float
  currentStock       Int          @default(0)
  minimumStock       Int          @default(0)
  isActive           Boolean      @default(true)
  brand              String?
  hsnCode            String?
  description        String?
  taxPercent         Float        @default(18.0)
  stockLocation      String       @default("Main Warehouse")
  modifiedBy         String       @default("Admin")
  modifiedAt         DateTime?
  densityVariants    String[]     @default([])
  boardVariants      String[]     @default([])
  thicknessVariants  String[]     @default([])
  reinforcementTypes String[]     @default([])
  otherSpecs         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model PurchaseOrder {
  id               Int            @id @default(autoincrement())
  poNumber         String         @unique
  supplier         String
  supplierIcon     String         @default("")
  date             DateTime
  amount           Float          @default(0)
  status           String         @default("Pending") // Received | Partial | Pending | Cancelled
  modifiedBy       String         @default("Admin")
  modifiedAt       DateTime?
  supplierAddress  String         @default("")
  buyerGst         String         @default("")
  pan              String         @default("")
  invoiceNo        String         @default("")
  invoiceDate      DateTime?
  despatchThrough  String         @default("")
  lrNo             String         @default("")
  lrDate           DateTime?
  vehicleNo        String         @default("")
  freight          Float          @default(0)
  placeOfSupply    String         @default("")
  dueDate          DateTime?
  /// Optional. When set, a background sweep flips the order to "Received" on
  /// that date — which is also what books the stock IN. Left null, the status
  /// (and therefore the stock) only moves when someone changes it by hand.
  expectedDelivery DateTime?
  /// "" | Full Payment | Half Payment | Other — how much of this order has
  /// been paid to the supplier, with [paidAmount] holding the figure.
  paymentType      String         @default("")
  paidAmount       Float          @default(0)
  items            PurchaseItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("purchase_orders")
}

model PurchaseItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // Set when the row was picked from the product autocomplete; drives which
  // product's stock this line moves. Null for free-typed legacy rows.
  productId       Int?
  productRef      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  product         String
  hsn             String        @default("")
  grade           String        @default("")
  density         String        @default("")
  qty             Float
  unit            String        @default("")
  rate            Float

  @@map("purchase_items")
}

model SalesOrder {
  id                Int        @id @default(autoincrement())
  soNumber          String     @unique
  client            String
  clientBadge       String     @default("")
  date              DateTime
  amount            Float      @default(0)
  status            String     @default("Confirmed") // Confirmed | Processing | Shipped | Delivered | Cancelled
  paymentStatus     String     @default("Pending") // Paid | Partial | Refunded | Pending
  modifiedBy        String     @default("Admin")
  modifiedAt        DateTime?
  clientAddress     String     @default("")
  buyerGstin        String     @default("")
  pan               String     @default("")
  invoiceNo         String     @default("")
  invoiceDate       DateTime?
  despatchedThrough String     @default("")
  destination       String     @default("")
  /// Optional. When set, a background sweep flips the order to "Delivered" on
  /// that date — which is also what books the stock OUT. Left null, the status
  /// (and therefore the stock) only moves when someone changes it by hand.
  expectedDelivery  DateTime?
  /// "" | Full Payment | Half Payment | Other, with [paidAmount] holding the
  /// figure the client has actually paid.
  paymentType       String     @default("")
  paidAmount        Float      @default(0)
  items             SaleItem[]
  bill              Bill?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("sales_orders")
}

model SaleItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    Int?
  productRef   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  product      String
  hsn          String     @default("")
  qty          Float
  unit         String     @default("")
  rate         Float

  @@map("sale_items")
}

model Client {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  name             String
  clientType       String    @default("")
  registrationType String    @default("Regular")
  email            String    @default("")
  phone            String    @default("")
  altPhone         String    @default("")
  gstin            String    @default("")
  pan              String    @default("")
  clientSince      DateTime?

  // Display address shown in the clients list. Legacy rows imported from the
  // accounting export only have this free-text blob; rows created through the
  // Add Client form get it composed from the registered-address fields below.
  address    String @default("")
  regAddr1   String @default("")
  regAddr2   String @default("")
  regCity    String @default("")
  regState   String @default("")
  regPin     String @default("")
  regCountry String @default("India")

  shipSameAsRegistered Boolean @default(true)
  shipSameAsBilling    Boolean @default(false)
  shipAddr1            String  @default("")
  shipAddr2            String  @default("")
  shipCity             String  @default("")
  shipState            String  @default("")
  shipPin              String  @default("")
  shipCountry          String  @default("India")

  // shipping | registered | custom
  billingMode String @default("shipping")
  billAddr1   String @default("")
  billAddr2   String @default("")
  billCity    String @default("")
  billState   String @default("")
  billPin     String @default("")
  billCountry String @default("India")

  paymentTerms   String @default("")
  priceList      String @default("")
  openingBalance Float  @default(0)
  creditLimit    Float  @default(0)
  creditDays     Int    @default(0)

  contactPerson      String @default("")
  contactDesignation String @default("")
  contactPhone       String @default("")
  contactEmail       String @default("")

  modifiedBy String    @default("Admin")
  modifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("clients")
}

/// Append-only ledger of every stock change. Product.currentStock is the
/// running total; these rows are what makes it auditable and reversible —
/// deleting a purchase/sales order reverses exactly the rows it created.
model StockMovement {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// IN | OUT | ADJUST
  type String

  /// Always positive; `type` carries the direction.
  qty Float

  /// Optional per-unit price — only ever set on a manual adjustment where the
  /// user chose to record one (e.g. an opening-balance entry). Purchase/sale
  /// movements leave this null; their price lives on the order's line items
  /// instead, which the Item Details ledger reads directly.
  rate Float?

  /// purchase | sale | manual
  refType String @default("manual")

  /// purchase_orders.id / sales_orders.id when refType isn't manual.
  refId Int?

  /// Human-readable origin, e.g. "PO-2024-10001".
  reference String @default("")
  note      String @default("")

  createdBy String   @default("Admin")
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([refType, refId])
  @@map("stock_movements")
}

/// Goods movement log shown on the Transactions page: what moved, for whom,
/// against which PO. Separate from `stock_movements`, which is the numeric
/// ledger behind Product.currentStock.
model Transaction {
  id   Int    @id @default(autoincrement())
  item String

  /// Inbound | Outbound
  type String

  party    String   @default("")
  poNumber String   @default("")
  date     DateTime

  /// Received | Shipped | Pending | Delivered
  status String @default("Pending")

  notes String @default("")

  modifiedBy String   @default("Admin")
  modifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
  @@map("transactions")
}

/// Notes / to-do items on the dashboard. Owned by the user who created them.
model DashboardNote {
  id     Int     @id @default(autoincrement())
  userId Int?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  text   String
  done   Boolean @default(false)

  /// Manual ordering in the widget.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("dashboard_notes")
}

/// The bill raised against a sale. One per sales order: a sale is billed once,
/// and re-opening the bill screen shows the document that was generated rather
/// than minting a new invoice number.
///
/// Line items, buyer and amounts are NOT copied here — they are read from the
/// sales order, so correcting a sale corrects its bill. Only what is specific
/// to the document lives here.
model Bill {
  id           Int        @id @default(autoincrement())
  salesOrderId Int        @unique
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  /// Invoice number in the billing series, e.g. "ST/0248/26-27". Assigned once,
  /// on generation, and never reused.
  invoiceNo String   @unique
  issuedOn  DateTime @default(now())

  // ── Per-invoice "what appears on the bill" overrides ────────────────────
  // Defaults come from the billing profile in app_settings; these five hold
  // whatever the user toggled for THIS invoice.
  showHsnSummary  Boolean @default(true)
  showBankDetails Boolean @default(true)
  showUpiQr       Boolean @default(true)
  showEInvoice    Boolean @default(true)
  showDeclaration Boolean @default(true)

  // ── e-Invoice (IRP) ─────────────────────────────────────────────────────
  // Null until an invoice is actually registered with the Invoice Registration
  // Portal. There is no IRP integration yet, so in practice these stay null and
  // the document prints "Not registered" rather than a made-up IRN.
  irn     String?
  ackNo   String?
  ackDate DateTime?

  generatedBy String      @default("Admin")
  events      BillEvent[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("bills")
}

/// One entry of a bill's audit trail — what happened, who did it, when.
/// Append-only: nothing here is ever edited or removed, which is the point.
model BillEvent {
  id     Int  @id @default(autoincrement())
  billId Int
  bill   Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  /// generated | irn_received | sent_whatsapp | sent_email | payment_received
  type String

  /// Free-text detail shown under the event, e.g. the number it was sent to.
  note String @default("")

  /// The person, or "System" for anything the app did on its own.
  actor String   @default("Admin")
  at    DateTime @default(now())

  @@index([billId])
  @@map("bill_events")
}

/// Business-wide configuration — a single row (id = 1). Not per-user: these
/// are shared settings every operator sees the same.
model AppSetting {
  id Int @id @default(1)

  /// Flag a product "Low Stock" when its currentStock falls to this level or
  /// below — applied only to products that have no per-item minimumStock set
  /// (minimumStock <= 0). 0 disables the global rule.
  lowStockThreshold Int @default(0)

  /// The white-label brand: colours, logo, company name, font and radius, as
  /// the Appearance screen saves it. Stored here rather than per-device
  /// because an admin sets the brand for the WHOLE portal — a per-browser
  /// copy would mean every employee saw a different app.
  brandTheme Json @default("{}")

  /// Seller identity, bank details, declaration and the default "what appears
  /// on the bill" toggles — everything the tax invoice prints that is not part
  /// of the sale. Portal-wide for the same reason the brand is.
  billingProfile Json @default("{}")

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
