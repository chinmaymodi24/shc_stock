# Copy to .env for local dev. On Render these are set in the dashboard.

# Local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shc_stock?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shc_stock?schema=public"

PORT=4000
UPLOADS_DIR=uploads

# Comma-separated allowed web origins. "*" allows any (local dev only).
CORS_ORIGINS=*

# Secret the session tokens are signed with. REQUIRED in production: left
# unset, the server derives one from DATABASE_URL, so anyone who learns the
# connection string could mint valid tokens. Any long random string works:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# AUTH_SECRET=

# How many reverse proxies sit in front of this server, so req.ip is the real
# caller and the sign-in rate limiter buckets per client. 0 for a direct run,
# 1 behind Render/nginx. Never set it above the true hop count.
TRUST_PROXY=0

# --- Neon (production) example ---
# DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
