<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (src/debug) — release keeps Android's HTTPS-only default.

  Since targetSdk 28 Android blocks cleartext HTTP by default. The platform's
  built-in config exempts `localhost`, which is why the app worked while the
  USB cable supplied `adb reverse tcp:4000` — and died the instant the cable
  came out, because the Wi-Fi LAN IP (e.g. http://192.168.1.6:4000) is NOT
  exempt and every request was blocked before it left the phone.

  Permitting cleartext for private LAN ranges lets a physical phone reach the
  dev backend over Wi-Fi with no cable.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
